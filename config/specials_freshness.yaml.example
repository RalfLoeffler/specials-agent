# Copy this file to config/specials_freshness.yaml to configure
# vendor freshness checks and fallback email messaging.
vendors:
  default:
    # Start a new weekly comparison cycle on this local-calendar day. The
    # last successfully delivered vendor snapshot becomes that cycle's fixed
    # freshness reference.
    start_day: "Wednesday"
    # A safely matched product price change is fresh immediately. Otherwise,
    # this many distinct physical offer additions/removals (after safe
    # duplicate/alias deduplication) are required before the vendor is fresh.
    # Three ignores one-off API search variation and a single replacement (two
    # changes).
    minimum_offer_changes: 3
    # If no fresh vendor data is detected by this local-calendar day, send the
    # current report anyway.
    force_send_day: "Saturday"
  # Optional per-vendor overrides.
  # coles:
  #   start_day: "Wednesday"
  #   minimum_offer_changes: 5
  #   force_send_day: "Saturday"
  # woolworths:
  #   start_day: "Wednesday"
  #   force_send_day: "Saturday"

email:
  # Uses email_config.yaml email_subject when omitted.
  # You can include placeholders in any subject/preamble:
  #   {vendor} or {vendors}: formatted vendor list, e.g. "Coles and Woolworths"
  #   {vendor_summary}: per-vendor status summary, e.g.
  #     "Coles: new_data; Woolworths: forced_send"
  success_subject: ""
  success_preamble: ""

  no_new_data_subject: "No new specials data for {vendor}"
  no_new_data_preamble: >-
    No new API specials data was detected for {vendor} yet; retrying on the
    next configured run day.

  forced_send_subject: "Saturday fallback specials for {vendor}"
  forced_send_preamble: >-
    No new API specials data was detected for {vendor} by the configured
    fallback day, so this report is sent anyway.

  # Used when one run includes multiple vendors with different states.
  mixed_subject: "Specials update ({vendor_summary})"
  mixed_preamble: >-
    This run contains mixed vendor freshness states: {vendor_summary}.
